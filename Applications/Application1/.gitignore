# Generated Application1 optimization / diagnostic / Navier-Stokes outputs.
# The velocity field is regenerated by the Navier-Stokes solve (see README);
# the DC mesh (DC_mesh/*.msh/.xdmf/.h5) and metadata are tracked separately.
# (clean_outputs.py protects output/navier_stokes/ independently of git.)
output/
__pycache__/
*.pyc

# Raw / intermediate GIS data and generated previews under DC_mesh that are NOT
# needed to regenerate the mesh from dc_navy_yard_domain.geojson +
# dc_navy_yard_clean_buildings.geojson. The 128 MB raw footprints download in
# particular must never enter git history.
DC_mesh/dc_building_footprints.geojson
DC_mesh/*_preview.png
DC_mesh/dc_navy_yard_building_labels.png

# Local experiment drivers and their helper scripts (kept out of the repository).
run_five_source_experiment.sh
run_lbfgs_restart_diagnostic.sh
run_m3_amplitude_solver_ab.sh
run_width_study.sh
test scripts/compare_m3_amplitude_solver_ab.py
test scripts/five_source_prepare.py
test scripts/five_source_report.py
test scripts/lbfgs_restart_diagnostic.py
test scripts/width_study_prepare.py
test scripts/width_study_report.py
test scripts/width_study_run_case.py
run_mesh_dependence_study.sh
run_mesh_dependence_study_add_levels.sh
test scripts/mesh_study_*.py
